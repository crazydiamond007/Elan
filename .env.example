# Copy to .env and replace the two placeholders; never commit .env.
# Generate secrets with: uv run python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-generated-secret

POSTGRES_DB=maison_elan
POSTGRES_USER=maison_elan
POSTGRES_PASSWORD=replace-with-a-generated-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_TEST_DB=test_maison_elan

# Production only; do not use development settings for public hosting.
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_ALLOWED_HOSTS=demo.example.com
# DJANGO_SITE_URL=https://demo.example.com
# DJANGO_MEDIA_ORIGIN=https://media.example.net
# DJANGO_TRUSTED_PROXY_NETWORKS=127.0.0.1/32
# DJANGO_CSRF_TRUSTED_ORIGINS=https://demo.example.com
# DJANGO_TRUST_PROXY_HTTPS=false
# DJANGO_HSTS_SECONDS=0
# POSTGRES_SSLROOTCERT=/path/to/provider-ca.pem
