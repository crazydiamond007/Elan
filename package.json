{
  "name": "maison-elan",
  "version": "0.1.0",
  "private": true,
  "description": "Tailwind CSS build tooling for the MAISON ÉLAN Django application",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "css:watch": "tailwindcss -i ./assets/css/app.css -o ./static/css/app.css --watch",
    "css:build": "tailwindcss -i ./assets/css/app.css -o ./static/css/app.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "tailwindcss": "4.3.0"
  }
}
